+#[test]
+fn ttl_renew_is_capped_and_never_wraps() {
+    assert_eq!(ttl_renew(100, 5, 1000), 105);
+    assert_eq!(ttl_renew(998, 5, 1000), 1000);
+    assert_eq!(ttl_renew(u32::MAX, 5, u32::MAX), u32::MAX);
+    assert_eq!(ttl_renew(u32::MAX - 1, 10, 500), 500);
+    // repeated 5 s renewals converge on the cap and stay there
+    let mut t = 0;
+    for _ in 0..1000 {
+        t = ttl_renew(t, 5, 300);
+        assert!(t <= 300);
+    }
+    assert_eq!(t, 300);
+}
+
+#[test]
+fn replay_by_node_is_grouped_and_stable() {
+    let mut events: Vec<Event> = (0..200)
+        .map(|i| Event { node: (i % 3) as u32, at: (i % 7) as u64, seq: i as u64, payload: String::new() })
+        .collect();
+    replay_order_by_node(&mut events);
+    for w in events.windows(2) {
+        assert!((w[0].node, w[0].at) <= (w[1].node, w[1].at));
+        if (w[0].node, w[0].at) == (w[1].node, w[1].at) {
+            assert!(w[0].seq < w[1].seq, "equal keys must keep arrival order");
+        }
+    }
+}
+
+#[test]
+fn cidr_key_tolerates_whitespace_and_bare_hosts() {
+    assert_eq!(cidr_key("  10.0.0.5/8\n").as_deref(), Some("10.0.0.0/8"));
+    assert_eq!(cidr_key("\t192.168.1.77 ").as_deref(), Some("192.168.1.77/32"));
+    assert_eq!(cidr_key("10.1.2.3/32"), cidr_key("10.1.2.3"));
+    assert_eq!(cidr_key("300.1.1.1"), None);
+    assert_eq!(cidr_key("1.2.3"), None);
+    assert_eq!(cidr_key(""), None);
+    assert_eq!(cidr_key("   "), None);
+    assert_eq!(cidr_key("10.0.0.5/"), None);
+    assert_eq!(cidr_key("10.0.0.5/33"), None);
+}
+
+#[test]
+fn jittered_retry_is_bounded_deterministic_and_below_idle_timeout() {
+    for attempt in 0..64 {
+        let base = retry_delay(attempt);
+        let mut distinct = std::collections::HashSet::new();
+        for seed in 0..500u64 {
+            let d = retry_delay_jittered(attempt, seed);
+            assert!(d >= base - base / 10 && d <= base + base / 10, "attempt {attempt} seed {seed}");
+            assert!(d < IDLE_TIMEOUT_MS, "attempt {attempt} seed {seed}");
+            assert_eq!(d, retry_delay_jittered(attempt, seed));
+            distinct.insert(d);
+        }
+        assert!(distinct.len() > 10, "seeds must actually spread the delays");
+    }
+    assert!(retry_delay_jittered(5, u64::MAX) < IDLE_TIMEOUT_MS);
+}
+
+#[test]
+fn default_route_block_is_a_valid_key() {
+    assert_eq!(cidr_normalize("0.0.0.0/0").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_normalize("10.1.2.3/0").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_key(" 0.0.0.0/0 ").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_normalize("1.2.3.4/33"), None);
+    assert_eq!(cidr_normalize("10.0.0.5/8").as_deref(), Some("10.0.0.0/8"));
+}
