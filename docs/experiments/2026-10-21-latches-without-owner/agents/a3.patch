+
+/// Renew a block's TTL (seconds): extend by `by`, never above `max`. Saturating, so it cannot wrap.
+pub fn ttl_renew(current: u32, by: u32, max: u32) -> u32 {
+    ttl_extend(current, by).min(max)
+}
+
+/// Group replay: order by `(node, at)` so each node's events are contiguous. The sort is stable,
+/// so equal `(node, at)` keep arrival order, as `replay_order` does for equal timestamps.
+pub fn replay_order_by_node(events: &mut Vec<Event>) {
+    events.sort_by_key(|e| (e.node, e.at));
+}
+
+/// Block key from sloppy input: surrounding whitespace is ignored, and a bare IPv4 address means
+/// that single host (`/32`). Everything else is judged by `cidr_normalize`.
+pub fn cidr_key(s: &str) -> Option<String> {
+    let s = s.trim();
+    if s.contains('/') {
+        cidr_normalize(s)
+    } else {
+        cidr_normalize(&format!("{s}/32"))
+    }
+}
+
+/// `retry_delay(attempt)` with a deterministic jitter of at most +/-10% derived from `seed`.
+/// The result stays below IDLE_TIMEOUT_MS: the cap is NOT raised for jittered delays, because a
+/// retry later than the peer's idle timeout finds the connection already dropped.
+pub fn retry_delay_jittered(attempt: u32, seed: u64) -> u64 {
+    let base = retry_delay(attempt);
+    // splitmix64 finalizer: spreads any seed (including 0 and sequential ones) over all bits
+    let mut z = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^= z >> 31;
+    let span = base / 10; // jitter in [-span, +span]
+    let offset = z % (2 * span + 1);
+    base - span + offset
+}
