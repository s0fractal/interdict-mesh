+
+/// Renew a block's TTL (seconds): extend by `by`, never above `max`. Never wraps.
+/// If `current` is already above `max`, the result is still `max` (the ceiling wins).
+pub fn ttl_renew(current: u32, by: u32, max: u32) -> u32 {
+    ttl_extend(current, by).min(max)
+}
+
+/// Group events by node, each node's events ordered by timestamp. The sort is stable, so equal
+/// `(node, at)` keep arrival order (same constraint as `replay_order`).
+pub fn replay_order_by_node(events: &mut Vec<Event>) {
+    events.sort_by_key(|e| (e.node, e.at));
+}
+
+/// Block key from sloppy input: surrounding whitespace is ignored and a bare IPv4 address means
+/// that single host (`/32`). Everything else goes through `cidr_normalize`, so the key is the
+/// same canonical form (host bits zeroed) and invalid input is `None`.
+pub fn cidr_key(s: &str) -> Option<String> {
+    let s = s.trim();
+    if s.contains('/') {
+        cidr_normalize(s)
+    } else {
+        cidr_normalize(&format!("{s}/32"))
+    }
+}
+
+/// `retry_delay(attempt)` with a deterministic jitter of at most +-10%, derived from `seed`.
+/// Built on the 30 s cap, so the result never exceeds 33 s and stays below IDLE_TIMEOUT_MS
+/// (a longer delay finds the peer connection already dropped).
+pub fn retry_delay_jittered(attempt: u32, seed: u64) -> u64 {
+    let base = retry_delay(attempt);
+    let span = base / 10;
+    // splitmix64 finalizer: a well-mixed deterministic value from the seed.
+    let mut z = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^= z >> 31;
+    base - span + z % (2 * span + 1)
+}
