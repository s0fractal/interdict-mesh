@@ -68,3 +68,41 @@ pub fn retry_delay(attempt: u32) -> u64 {
     let shift = attempt.min(16);
     (RETRY_BASE_MS << shift).min(RETRY_CAP_MS)
 }
+
+/// Renew a block's TTL (seconds): extended by `by`, never above `max`. Never wraps, so a lease
+/// loop renewing every 5 s cannot overflow it. If `current` is already above `max` the result is
+/// `max` (the ceiling is stated as absolute).
+pub fn ttl_renew(current: u32, by: u32, max: u32) -> u32 {
+    ttl_extend(current, by).min(max)
+}
+
+/// Order events by `(node, at)` so each node's events are contiguous. The sort is stable, so
+/// events equal on both keys keep arrival order (same constraint as `replay_order`).
+pub fn replay_order_by_node(events: &mut Vec<Event>) {
+    events.sort_by_key(|e| (e.node, e.at));
+}
+
+/// Block key from sloppy input: surrounding whitespace is ignored and a bare IPv4 address
+/// (no `/`) means that single host (`/32`). Everything else goes through `cidr_normalize`,
+/// so equal networks still yield one key.
+pub fn cidr_key(s: &str) -> Option<String> {
+    let s = s.trim();
+    if s.contains('/') {
+        cidr_normalize(s)
+    } else {
+        cidr_normalize(&format!("{s}/32"))
+    }
+}
+
+/// `retry_delay(attempt)` with a deterministic jitter of -10%..+10% derived from `seed`
+/// (splitmix64), so different seeds spread out while one seed always gives the same delay.
+/// The cap is NOT raised: the jittered delay is at most 1.1 * RETRY_CAP_MS = 33 s, which stays
+/// below IDLE_TIMEOUT_MS (a 60 s delay would outlive the peer's 45 s idle timeout).
+pub fn retry_delay_jittered(attempt: u32, seed: u64) -> u64 {
+    let mut z = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^= z >> 31;
+    let permille = 900 + z % 201; // 900..=1100
+    retry_delay(attempt) * permille / 1000
+}
