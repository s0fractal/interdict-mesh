@@ -0,0 +1,69 @@
+use ledger::*;
+
+#[test]
+fn ttl_renew_extends_and_caps() {
+    assert_eq!(ttl_renew(100, 5, 3600), 105);
+    assert_eq!(ttl_renew(3598, 5, 3600), 3600);
+    assert_eq!(ttl_renew(u32::MAX, 5, u32::MAX), u32::MAX);
+    assert_eq!(ttl_renew(u32::MAX - 1, 10, 500), 500);
+    let mut t = 0;
+    for _ in 0..1000 {
+        t = ttl_renew(t, 5, 3600);
+        assert!(t <= 3600);
+    }
+    assert_eq!(t, 3600);
+}
+
+fn ev(node: u32, at: u64, seq: u64) -> Event {
+    Event { node, at, seq, payload: String::new() }
+}
+
+#[test]
+fn replay_order_by_node_groups_and_is_stable() {
+    let mut events: Vec<Event> = (0..200).map(|i| ev((i % 3) as u32, (i % 7) as u64, i as u64)).collect();
+    replay_order_by_node(&mut events);
+    for w in events.windows(2) {
+        assert!((w[0].node, w[0].at) <= (w[1].node, w[1].at));
+        if (w[0].node, w[0].at) == (w[1].node, w[1].at) {
+            assert!(w[0].seq < w[1].seq, "ties must keep arrival order");
+        }
+    }
+}
+
+#[test]
+fn cidr_key_tolerates_whitespace_and_bare_hosts() {
+    assert_eq!(cidr_key("  10.0.0.5 \n").as_deref(), Some("10.0.0.5/32"));
+    assert_eq!(cidr_key("\t10.0.0.5/8 ").as_deref(), Some("10.0.0.0/8"));
+    assert_eq!(cidr_key("10.0.0.5/8"), cidr_key("10.0.0.0/8"));
+    assert_eq!(cidr_key("10.0.0.5/32"), cidr_key("10.0.0.5"));
+    assert_eq!(cidr_key("300.1.1.1"), None);
+    assert_eq!(cidr_key(""), None);
+    assert_eq!(cidr_key("10.0.0"), None);
+    assert_eq!(cidr_key("10.0.0.5/"), None);
+}
+
+#[test]
+fn retry_delay_jittered_is_bounded_deterministic_and_below_idle_timeout() {
+    for attempt in 0..64 {
+        let base = retry_delay(attempt);
+        let mut distinct = std::collections::HashSet::new();
+        for seed in 0..500u64 {
+            let d = retry_delay_jittered(attempt, seed);
+            assert_eq!(d, retry_delay_jittered(attempt, seed));
+            assert!(d >= base * 9 / 10 && d <= base * 11 / 10, "attempt {attempt} seed {seed}");
+            assert!(d < IDLE_TIMEOUT_MS);
+            distinct.insert(d);
+        }
+        assert!(distinct.len() > 50, "jitter must spread");
+    }
+}
+
+#[test]
+fn default_route_block_is_a_valid_key() {
+    assert_eq!(cidr_normalize("0.0.0.0/0").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_normalize("10.1.2.3/0").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_key(" 0.0.0.0/0 ").as_deref(), Some("0.0.0.0/0"));
+    assert_eq!(cidr_normalize("1.2.3.4/33"), None);
+    assert_eq!(cidr_normalize("10.0.0.5/8").as_deref(), Some("10.0.0.0/8"));
+    assert_eq!(cidr_normalize("10.1.2.3/32").as_deref(), Some("10.1.2.3/32"));
+}
