# interdictd, the interdict-mesh node, as an unprivileged service.
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin interdict
#   groupadd --system interdict-ipc            # members may send DROP_IMMEDIATE (e.g. trident_trap)
#   groupadd --system interdict-ops            # members may ban/unban via the control socket (interdict-ctl)
#   install -m 0755 target/release/orchestrator /usr/local/bin/interdictd
#   install -m 0644 deploy/interdictd.service /etc/systemd/system/
#   edit /etc/default/interdict (see INTERDICT_ARGS below), then: systemctl enable --now interdictd
[Unit]
Description=interdict-mesh node (XDP enforcement and mesh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=interdict
Group=interdict
SupplementaryGroups=interdict-ipc interdict-ops
EnvironmentFile=-/etc/default/interdict
# Example /etc/default/interdict:
#   INTERDICT_ARGS=--interface eth0 --node-id 1 --peers-file /etc/interdict/peers.json --never-block 203.0.113.0/24
ExecStart=/usr/local/bin/interdictd \
    --db-path /var/lib/interdict/audit.log \
    --key-file /var/lib/interdict/node.key \
    --ipc-socket /run/interdict/interdict.sock \
    --ipc-group interdict-ipc \
    --control-socket /run/interdict/control.sock \
    --control-group interdict-ops \
    $INTERDICT_ARGS
Restart=on-failure
RestartSec=2s

# Exactly what XDP attach, map creation/updates and the verifier need (verified in
# scripts/xdp-smoke.sh: without CAP_PERFMON the load is refused).
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON
NoNewPrivileges=yes
# BPF maps are charged to locked memory on kernels before 5.11.
LimitMEMLOCK=infinity

StateDirectory=interdict
StateDirectoryMode=0700
RuntimeDirectory=interdict
RuntimeDirectoryMode=0755

ProtectSystem=strict
# --anchor-dir (ADR-0022, opt-in) lives outside the state directory; ignored if absent.
ReadWritePaths=-/var/lib/interdict-anchors
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
